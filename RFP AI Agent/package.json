{
  "name": "rfp-ai-agent-rag",
  "version": "1.0.0",
  "description": "RAG-powered AI agent for accelerated RFP response generation using SharePoint and Confluence as knowledge sources.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:webhook": "node dist/server.js",
    "dev": "ts-node src/index.ts",
    "dev:webhook": "ts-node src/server.ts",
    "index:all": "npm run build && node dist/scripts/sync-knowledge-base.js",
    "index:sharepoint": "npm run build && node dist/scripts/index-sharepoint.js",
    "index:confluence": "npm run build && node dist/scripts/index-confluence.js",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "body-parser": "^1.20.4",
    "chromadb": "^1.3.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "js-base64": "^3.7.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.2"
  }
}
