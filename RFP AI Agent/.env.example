# SharePoint configuration
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/proposals
SHAREPOINT_LIBRARY_NAME=Shared Documents

# Confluence configuration
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=confluence-api-user@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEYS=PROPOSALS,POLICIES,CASESTUDIES

# LLM configuration
LLM_PROVIDER=openai
# Options: openai, anthropic, ollama
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings configuration
EMBEDDINGS_PROVIDER=openai
# Options: openai, huggingface, ollama
EMBEDDINGS_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=hf_...

# Vector store configuration
VECTOR_STORE_PROVIDER=chroma
# Options: chroma, pinecone, qdrant
CHROMA_COLLECTION_NAME=rfp-knowledge-base
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=pk-...
PINECONE_INDEX_NAME=rfp-kb
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rfp-kb

# RAG configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Server configuration
PORT=3000
LOG_LEVEL=info
